ScreenManager:
    CreateCardScreen:
        name: "create"
    CardsScreen:
        name: "cards"

<NavBar@BoxLayout>:
    size_hint_y: None
    height: dp(48)
    spacing: dp(8)
    padding: dp(8)

    Button:
        text: "Créer une carte"
        on_release: app.root.current = "create"

    Button:
        text: "Cartes existantes"
        on_release: app.root.current = "cards"
