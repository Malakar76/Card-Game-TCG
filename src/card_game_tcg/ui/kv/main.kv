ScreenManager:
    canvas.before:
        Color:
            rgba: 0.10, 0.10, 0.18, 1
        Rectangle:
            pos: self.pos
            size: self.size

    SearchScreen:
        name: "search"
    CardsScreen:
        name: "cards"
    ScanScreen:
        name: "scan"
    EvolutionScreen:
        name: "evolution"

<NavBar@BoxLayout>:
    size_hint_y: None
    height: dp(52)
    spacing: dp(0)
    padding: [dp(12), dp(4), dp(12), dp(0)]

    canvas.before:
        Color:
            rgba: 0.06, 0.20, 0.38, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [0, 0, dp(8), dp(8)]
        # Bottom gold separator
        Color:
            rgba: 0.89, 0.72, 0.08, 0.6
        Rectangle:
            pos: self.x, self.y
            size: self.width, dp(2)

    Button:
        text: "Collection"
        font_size: sp(15)
        bold: True
        size_hint_x: 1
        background_normal: ""
        background_color: (0.89, 0.72, 0.08, 1) if getattr(app.root, 'current', '') == "cards" else (0.06, 0.20, 0.38, 0)
        color: (0.10, 0.10, 0.18, 1) if getattr(app.root, 'current', '') == "cards" else (0.92, 0.92, 0.92, 1)
        on_release: app.root.current = "cards"
        canvas.before:
            Color:
                rgba: (0.89, 0.72, 0.08, 1) if getattr(app.root, 'current', '') == "cards" else (0.92, 0.92, 0.92, 0.15)
            Line:
                rounded_rectangle: [self.x + dp(4), self.y + dp(4), self.width - dp(8), self.height - dp(8), dp(6)]
                width: 1.2

    Button:
        text: "Recherche"
        font_size: sp(15)
        bold: True
        size_hint_x: 1
        background_normal: ""
        background_color: (0.89, 0.72, 0.08, 1) if getattr(app.root, 'current', '') == "search" else (0.06, 0.20, 0.38, 0)
        color: (0.10, 0.10, 0.18, 1) if getattr(app.root, 'current', '') == "search" else (0.92, 0.92, 0.92, 1)
        on_release: app.root.current = "search"
        canvas.before:
            Color:
                rgba: (0.89, 0.72, 0.08, 1) if getattr(app.root, 'current', '') == "search" else (0.92, 0.92, 0.92, 0.15)
            Line:
                rounded_rectangle: [self.x + dp(4), self.y + dp(4), self.width - dp(8), self.height - dp(8), dp(6)]
                width: 1.2

    Button:
        text: "Scanner"
        font_size: sp(15)
        bold: True
        size_hint_x: 1
        background_normal: ""
        background_color: (0.89, 0.72, 0.08, 1) if getattr(app.root, 'current', '') == "scan" else (0.06, 0.20, 0.38, 0)
        color: (0.10, 0.10, 0.18, 1) if getattr(app.root, 'current', '') == "scan" else (0.92, 0.92, 0.92, 1)
        on_release: app.root.current = "scan"
        canvas.before:
            Color:
                rgba: (0.89, 0.72, 0.08, 1) if getattr(app.root, 'current', '') == "scan" else (0.92, 0.92, 0.92, 0.15)
            Line:
                rounded_rectangle: [self.x + dp(4), self.y + dp(4), self.width - dp(8), self.height - dp(8), dp(6)]
                width: 1.2
