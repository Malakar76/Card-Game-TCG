<EvolutionScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(12)

        canvas.before:
            Color:
                rgba: 0.10, 0.10, 0.18, 1
            Rectangle:
                pos: self.pos
                size: self.size

        NavBar:

        Label:
            text: "Famille de " + root.pokemon_name if root.pokemon_name else "Famille d'évolution"
            font_size: sp(22)
            size_hint_y: None
            height: dp(50)
            bold: True
            color: 0.89, 0.72, 0.08, 1
            text_size: self.width, None
            halign: "center"

        # Status text
        Label:
            text: root.status_text
            size_hint_y: None
            height: dp(28)
            font_size: sp(14)
            color: 0.53, 0.53, 0.53, 1

        RecycleView:
            id: rv
            data: root.chain_data
            viewclass: "EvolutionRow"
            size_hint_y: 1

            RecycleBoxLayout:
                default_size: None, dp(120)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: "vertical"
                spacing: dp(8)
                padding: [dp(0), dp(4), dp(0), dp(4)]

        # Back button
        Button:
            text: "Retour au scanner"
            size_hint_y: None
            height: dp(50)
            font_size: sp(16)
            bold: True
            background_normal: ""
            background_color: 0.06, 0.20, 0.38, 1
            color: 0.89, 0.72, 0.08, 1
            on_release: root.go_back()
            canvas.before:
                Color:
                    rgba: 0.89, 0.72, 0.08, 0.6
                Line:
                    rounded_rectangle: [self.x + dp(2), self.y + dp(2), self.width - dp(4), self.height - dp(4), dp(6)]
                    width: 1.1

<EvolutionRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(120)
    padding: [dp(10), dp(8), dp(10), dp(8)]
    spacing: dp(12)

    canvas.before:
        Color:
            rgba: 0.09, 0.13, 0.24, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: 0.89, 0.72, 0.08, 0.4
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(8)]
            width: 1.1

    AsyncImage:
        source: root.evo_image
        size_hint: None, 1
        width: dp(80)
        fit_mode: "contain"
        opacity: 1 if root.evo_image else 0

    BoxLayout:
        orientation: "vertical"
        spacing: dp(4)
        padding: [dp(0), dp(8), dp(0), dp(8)]

        Label:
            text: root.evo_name
            bold: True
            font_size: sp(17)
            color: 0.92, 0.92, 0.92, 1
            text_size: self.width, None
            halign: "left"
            valign: "middle"

        Label:
            text: root.evo_stage
            font_size: sp(13)
            color: 0.89, 0.72, 0.08, 0.8
            text_size: self.width, None
            halign: "left"
            valign: "middle"
