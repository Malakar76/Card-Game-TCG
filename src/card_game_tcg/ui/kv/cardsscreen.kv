<CardsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(12)

        canvas.before:
            Color:
                rgba: 0.10, 0.10, 0.18, 1
            Rectangle:
                pos: self.pos
                size: self.size

        NavBar:

        Label:
            text: "Collection"
            font_size: sp(26)
            size_hint_y: None
            height: dp(50)
            bold: True
            color: 0.89, 0.72, 0.08, 1

        # Empty state message
        Label:
            text: "Aucune carte dans la collection" if not rv.data else ""
            size_hint_y: None
            height: dp(40) if not rv.data else dp(0)
            opacity: 1 if not rv.data else 0
            color: 0.53, 0.53, 0.53, 1
            font_size: sp(15)

        RecycleView:
            id: rv
            viewclass: "CardRow"
            size_hint_y: 1

            RecycleBoxLayout:
                default_size: None, dp(100)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: "vertical"
                spacing: dp(10)
                padding: [dp(0), dp(4), dp(0), dp(4)]

<CardRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(100)
    padding: [dp(10), dp(8), dp(10), dp(8)]
    spacing: dp(10)

    canvas.before:
        Color:
            rgba: 0.09, 0.13, 0.24, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: 0.89, 0.72, 0.08, 0.4
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(8)]
            width: 1.1

    AsyncImage:
        source: root.card_image
        size_hint: None, 1
        width: dp(60)
        fit_mode: "contain"
        opacity: 1 if root.card_image else 0

    BoxLayout:
        orientation: "vertical"
        spacing: dp(4)

        Label:
            text: root.card_name
            bold: True
            font_size: sp(16)
            color: 0.92, 0.92, 0.92, 1
            text_size: self.width, None
            halign: "left"
            valign: "middle"

        Label:
            text: root.tcgdex_id
            font_size: sp(12)
            color: 0.53, 0.53, 0.53, 1
            text_size: self.width, None
            halign: "left"
            valign: "top"

    Button:
        text: "X"
        size_hint_x: None
        width: dp(44)
        font_size: sp(20)
        bold: True
        background_normal: ""
        background_color: 0.70, 0.15, 0.15, 1
        color: 1, 1, 1, 1
        on_release: root.delete_from_collection()
        canvas.before:
            Color:
                rgba: 0.70, 0.15, 0.15, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(6)]
