<CreateCardScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(8)

        canvas.before:
            Color:
                rgba: 0.10, 0.10, 0.18, 1
            Rectangle:
                pos: self.pos
                size: self.size

        NavBar:

        Label:
            text: u"Cr\xe9er une carte"
            font_size: sp(26)
            size_hint_y: None
            height: dp(50)
            bold: True
            color: 0.89, 0.72, 0.08, 1

        ScrollView:
            size_hint_y: 1

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(16)
                padding: [dp(4), dp(8), dp(4), dp(8)]

                # --- Nom ---
                Label:
                    text: "Nom *"
                    font_size: sp(14)
                    color: 0.92, 0.92, 0.92, 1
                    size_hint_y: None
                    height: dp(24)
                    text_size: self.width, None
                    halign: "left"
                TextInput:
                    id: name_input
                    multiline: False
                    size_hint_y: None
                    height: dp(44)
                    font_size: sp(15)
                    foreground_color: 0.92, 0.92, 0.92, 1
                    background_color: 0.09, 0.13, 0.24, 1
                    cursor_color: 0.89, 0.72, 0.08, 1
                    hint_text: "Nom de la carte"
                    hint_text_color: 0.53, 0.53, 0.53, 1
                    padding: [dp(12), dp(10), dp(12), dp(10)]

                # --- Description ---
                Label:
                    text: "Description"
                    font_size: sp(14)
                    color: 0.92, 0.92, 0.92, 1
                    size_hint_y: None
                    height: dp(24)
                    text_size: self.width, None
                    halign: "left"
                TextInput:
                    id: description_input
                    multiline: True
                    size_hint_y: None
                    height: dp(88)
                    font_size: sp(15)
                    foreground_color: 0.92, 0.92, 0.92, 1
                    background_color: 0.09, 0.13, 0.24, 1
                    cursor_color: 0.89, 0.72, 0.08, 1
                    hint_text: "Description de la carte"
                    hint_text_color: 0.53, 0.53, 0.53, 1
                    padding: [dp(12), dp(10), dp(12), dp(10)]

                # --- Stats row ---
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(80)
                    spacing: dp(12)

                    # ATK
                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(4)
                        Label:
                            text: "Attaque"
                            font_size: sp(14)
                            color: 0.91, 0.30, 0.24, 1
                            size_hint_y: None
                            height: dp(24)
                            text_size: self.width, None
                            halign: "left"
                        TextInput:
                            id: attack_input
                            text: "0"
                            input_filter: "int"
                            multiline: False
                            size_hint_y: None
                            height: dp(44)
                            font_size: sp(15)
                            foreground_color: 0.91, 0.30, 0.24, 1
                            background_color: 0.09, 0.13, 0.24, 1
                            cursor_color: 0.89, 0.72, 0.08, 1
                            halign: "center"
                            padding: [dp(12), dp(10), dp(12), dp(10)]

                    # DEF
                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(4)
                        Label:
                            text: u"D\xe9fense"
                            font_size: sp(14)
                            color: 0.20, 0.60, 0.86, 1
                            size_hint_y: None
                            height: dp(24)
                            text_size: self.width, None
                            halign: "left"
                        TextInput:
                            id: defense_input
                            text: "0"
                            input_filter: "int"
                            multiline: False
                            size_hint_y: None
                            height: dp(44)
                            font_size: sp(15)
                            foreground_color: 0.20, 0.60, 0.86, 1
                            background_color: 0.09, 0.13, 0.24, 1
                            cursor_color: 0.89, 0.72, 0.08, 1
                            halign: "center"
                            padding: [dp(12), dp(10), dp(12), dp(10)]

                    # COST
                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(4)
                        Label:
                            text: u"Co\xfbt"
                            font_size: sp(14)
                            color: 0.89, 0.72, 0.08, 1
                            size_hint_y: None
                            height: dp(24)
                            text_size: self.width, None
                            halign: "left"
                        TextInput:
                            id: cost_input
                            text: "0"
                            input_filter: "int"
                            multiline: False
                            size_hint_y: None
                            height: dp(44)
                            font_size: sp(15)
                            foreground_color: 0.89, 0.72, 0.08, 1
                            background_color: 0.09, 0.13, 0.24, 1
                            cursor_color: 0.89, 0.72, 0.08, 1
                            halign: "center"
                            padding: [dp(12), dp(10), dp(12), dp(10)]

                # --- Create button ---
                Widget:
                    size_hint_y: None
                    height: dp(8)

                Button:
                    text: u"Cr\xe9er la carte"
                    size_hint_y: None
                    height: dp(50)
                    font_size: sp(17)
                    bold: True
                    background_normal: ""
                    background_color: 0.89, 0.72, 0.08, 1
                    color: 0.10, 0.10, 0.18, 1
                    on_release: root.create_card(name_input.text, description_input.text, attack_input.text, defense_input.text, cost_input.text)
                    canvas.before:
                        Color:
                            rgba: 0.89, 0.72, 0.08, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]

                # --- Status message ---
                Label:
                    text: root.status_text
                    size_hint_y: None
                    height: dp(30)
                    font_size: sp(14)
                    color: (0.2, 0.8, 0.2, 1) if root.status_text and "erreur" not in root.status_text.lower() and "requis" not in root.status_text.lower() else (0.91, 0.30, 0.24, 1)
